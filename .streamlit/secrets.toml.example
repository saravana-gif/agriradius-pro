# AgriRadius Pro - secrets template
# ---------------------------------
# Copy this file to .streamlit/secrets.toml for LOCAL runs, and paste
# the same contents into Streamlit Community Cloud -> App -> Settings
# -> Secrets for the DEPLOYED app. Never commit the real secrets.toml.
#
# IMPORTANT TOML RULE: put every plain key (DATA_GOV_API_KEY,
# GSHEET_ID, the service accounts, OWNER_EMAIL, ...) FIRST, and keep
# the [auth] section LAST. In TOML, every key after a [section] header
# belongs to that section - so if [auth] is on top, your service
# account ends up nested inside it and Earth Engine can't find it.

# --- Mandi prices (data.gov.in) ---
DATA_GOV_API_KEY = "your-data-gov-in-api-key"

# --- Shared field data (Google Sheets) ---
# The Sheet's ID, taken from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GSHEET_ID = "your-google-sheet-id"

# --- Login: who is the first owner / allowed domain ---
OWNER_EMAIL = "saravana@oneroot.farm"
SSO_ALLOWED_DOMAIN = "oneroot.farm"

# --- Google service account (powers BOTH Earth Engine and Sheets) ---
# Paste the full service-account JSON as a single triple-quoted string.
# Share the Google Sheet with this account's client_email (Editor),
# and register the same service account for Earth Engine.
GCP_SERVICE_ACCOUNT = '''
{
  "type": "service_account",
  "project_id": "your-project",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "agriradius@your-project.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "..."
}
'''

# Earth Engine reads the same service account:
EE_SERVICE_ACCOUNT = '''
{ ... paste the SAME JSON as GCP_SERVICE_ACCOUNT ... }
'''

# =====================================================================
# KEEP [auth] LAST. Everything below this line belongs to the [auth]
# table; nothing else may follow it.
# =====================================================================
# When this [auth] block is present, the app requires Google sign-in;
# only emails in the "Users" allowlist (People & Access panel) get in.
# Setup: Google Cloud Console -> Credentials -> OAuth client ID (Web).
#   Authorised redirect URI (must match EXACTLY):
#     https://agriradius-pro-ytsri4v3cvjcwt3vnvjabl.streamlit.app/oauth2callback
[auth]
redirect_uri = "https://agriradius-pro-ytsri4v3cvjcwt3vnvjabl.streamlit.app/oauth2callback"
cookie_secret = "change-me-to-a-long-random-string"
client_id = "your-google-oauth-client-id.apps.googleusercontent.com"
client_secret = "your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
